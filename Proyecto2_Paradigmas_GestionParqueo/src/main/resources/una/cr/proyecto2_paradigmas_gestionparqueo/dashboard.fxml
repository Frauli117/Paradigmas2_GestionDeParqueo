<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1050.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="una.cr.proyecto2_paradigmas_gestionparqueo.DashboardController">
    <top>
        <VBox styleClass="header" spacing="5.0">
            <padding><Insets top="22" right="30" bottom="22" left="30"/></padding>
            <Label styleClass="title" text="Sistema de Gestión de Parqueo"/>
            <Label styleClass="subtitle" text="Control de entradas, salidas, pagos y espacios"/>
        </VBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="28.0">
            <padding><Insets top="35" right="45" bottom="35" left="45"/></padding>
            <Label styleClass="section-title" text="Resumen actual"/>
            <GridPane alignment="CENTER" hgap="18" vgap="18">
                <children>
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="stat-card" alignment="CENTER" spacing="8">
                        <Label fx:id="lblAvailable" styleClass="stat-number" text="0"/>
                        <Label styleClass="stat-label" text="Espacios disponibles"/>
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="stat-card" alignment="CENTER" spacing="8">
                        <Label fx:id="lblOccupied" styleClass="stat-number" text="0"/>
                        <Label styleClass="stat-label" text="Espacios ocupados"/>
                    </VBox>
                    <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="stat-card" alignment="CENTER" spacing="8">
                        <Label fx:id="lblOutOfService" styleClass="stat-number" text="0"/>
                        <Label styleClass="stat-label" text="Fuera de servicio"/>
                    </VBox>
                    <VBox GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="stat-card" alignment="CENTER" spacing="8">
                        <Label fx:id="lblActiveTickets" styleClass="stat-number" text="0"/>
                        <Label styleClass="stat-label" text="Tiquetes activos"/>
                    </VBox>
                </children>
            </GridPane>
            <Label styleClass="section-title" text="Operaciones"/>
            <HBox alignment="CENTER" spacing="18">
                <Button styleClass="menu-button" text="Registrar entrada" onAction="#openEntry"/>
                <Button styleClass="menu-button" text="Salida y pago" onAction="#openPayment"/>
                <Button styleClass="menu-button" text="Administrar espacios" onAction="#openSpaces"/>
            </HBox>
            <Button styleClass="secondary-button" text="Actualizar resumen" onAction="#refreshSummary"/>
        </VBox>
    </center>
</BorderPane>
