<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1050.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="una.cr.proyecto2_paradigmas_gestionparqueo.EntryController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="header">
            <padding><Insets top="18" right="25" bottom="18" left="25"/></padding>
            <Button styleClass="back-button" text="← Volver" onAction="#goBack"/>
            <VBox>
                <Label styleClass="title-small" text="Registrar entrada"/>
                <Label styleClass="subtitle" text="Ingrese los datos del vehículo para asignar un espacio compatible."/>
            </VBox>
        </HBox>
    </top>
    <center>
        <HBox spacing="24">
            <padding><Insets top="28" right="30" bottom="30" left="30"/></padding>
            <VBox prefWidth="360" spacing="16" styleClass="panel">
                <Label styleClass="section-title" text="Datos del vehículo"/>
                <GridPane hgap="12" vgap="12">
                    <Label text="Tipo" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbVehicleType" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Placa" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtPlate" promptText="ABC123" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Marca" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtBrand" promptText="Toyota" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Modelo" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtModel" promptText="Corolla" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Color" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtColor" promptText="Gris" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>
                <Button maxWidth="1.7976931348623157E308" styleClass="primary-button" text="Registrar entrada" onAction="#registerEntry"/>
                <Label wrapText="true" styleClass="help-text" text="El sistema buscará automáticamente el primer espacio disponible correspondiente al tipo de vehículo."/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="panel">
                <Label styleClass="section-title" text="Vehículos dentro del parqueo"/>
                <TableView fx:id="tblActiveTickets" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTicket" prefWidth="75" text="# Tiquete"/>
                        <TableColumn fx:id="colPlate" prefWidth="105" text="Placa"/>
                        <TableColumn fx:id="colType" prefWidth="120" text="Tipo"/>
                        <TableColumn fx:id="colSpace" prefWidth="100" text="Espacio"/>
                        <TableColumn fx:id="colEntry" prefWidth="165" text="Entrada"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
